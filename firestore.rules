rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only the organiser account can read or change anything as an admin.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'lebogangraseona576@gmail.com';
    }

    // Guests: may CREATE a registration (nothing else). Organiser: full access.
    match /registrations/{ticketCode} {
      allow create: if request.resource.data.keys().hasOnly(['fullName','phone','email','ticketCode','submittedAt'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0 && request.resource.data.fullName.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[0-9+ ()\\-]{9,20}$')
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.ticketCode == ticketCode
        && ticketCode.matches('^DERUN-[0-9]{4}-[A-Z0-9]{6}$')
        && request.resource.data.submittedAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Wristband check-ins: organiser only.
    match /attendance/{id} {
      allow read, write: if isAdmin();
    }

    // Everything else is locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
